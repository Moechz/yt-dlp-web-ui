#!/bin/bash
# prerm - 删除/升级前处理（官方模板：清杀应用用户全部残留进程 + 停用服务）
set -e

MAINT_LOG=/var/log/ytdlpwebui-maint.log
mkdir -p /var/log 2>/dev/null || true
echo "$(date '+%F %T') prerm $*" >> "$MAINT_LOG" 2>/dev/null || true

# 停用服务（升级路径只停不 disable——重新启用交给新版 postinst；dpkg 会替换 unit 文件）
systemctl stop ytdlpwebui.service 2>/dev/null || true

# 清杀应用用户的残留进程（升级安全；yt-dlp/ffmpeg/qjs 子进程可能仍在跑）
pkill -u ytdlpwebui 2>/dev/null || true
sleep 1

if [ "$1" = "remove" ] || [ "$1" = "deconfigure" ]; then
  systemctl disable ytdlpwebui.service 2>/dev/null || true
fi

exit 0
