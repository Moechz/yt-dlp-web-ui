# ============================================================
# yt-dlp Web UI 用户配置（由 ytdlpwebui.env.example 首装复制而来）
# 修改后执行: systemctl restart ytdlpwebui
#
# 配置优先级: 本文件的环境变量(APP_*) > /usr/local/ytdlpwebui/config.yml
#             > 内置默认值
# （上游用 viper 读取，前缀 APP，键名中的 '.' 写成 '_'，例如
#   server.host -> APP_SERVER_HOST）
#
# 安全说明：以下 host/port 活动默认值与随包的 config.yml 互为双保险——
# 即使误删 config.yml 或误删本文件，服务也只会监听回环、不会端口外泄。
# ============================================================

# 监听地址与端口（默认仅回环；TOS nginx 经 /ytdlpwebui/ 路由转发）
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=13033

# 并发下载队列长度
APP_SERVER_QUEUE_SIZE=2

# 下载文件保存目录（默认在数据目录内）。
# 如需保存到共享卷：先在 TOS「共享文件夹 → 应用用户」中给 ytdlpwebui
# 用户授予读写权限，再在下方填写绝对路径并重启服务。
APP_PATHS_DOWNLOAD_PATH=/var/lib/ytdlpwebui/downloads

# yt-dlp 与 JS 运行时路径（随包预置，一般无需修改）
APP_PATHS_DOWNLOADER_PATH=/usr/local/ytdlpwebui/bin/yt-dlp
APP_PATHS_JS_RUNTIME_PATH=quickjs:/usr/local/ytdlpwebui/bin/qjs

# 队列数据库目录与日志
APP_PATHS_LOCAL_DATABASE_PATH=/var/lib/ytdlpwebui
APP_LOGGING_ENABLE_FILE_LOGGING=true
APP_LOGGING_LOG_PATH=/var/lib/ytdlpwebui/yt-dlp-webui.log

# 应用内账号（默认关闭；如需额外一层认证可改为 true 并配置 bcrypt 密码哈希，
# 一般无需开启，TOS 网页服务已提供登录保护）
#APP_AUTHENTICATION_REQUIRE_AUTH=false
#APP_AUTHENTICATION_USERNAME=admin
#APP_AUTHENTICATION_PASSWORD_HASH=$2a$10$...
