+// TOS patch (Moechz/yt-dlp-web-ui): when the app is served from a
+// reverse-proxy sub-path such as https://<nas>:8181/ytdlpwebui/, the mount
+// prefix lives in window.location.pathname. The upstream code only knows
+// hostname:port, so REST/RPC/WebSocket calls would miss the proxied route
+// and hit the server root. Derive the prefix from the browser path and
+// append it; when the app runs at the site root the prefix is empty and
+// behaviour is unchanged.
+const tosMountPrefix = () => {
+  const p = window.location.pathname.replace(/\/+$/, '')
+  return p === '/' ? '' : p
+}
