# ============================================================
# yt-dlp Web UI — TOS 7 应用中心 deb 打包配置
# 修改后重新运行 ./build.sh 即可
# ============================================================

# 上游版本（GitHub tag，不带 v 前缀）
# 主仓库: https://github.com/marcopiovanello/yt-dlp-web-ui
YTDLPWEBUI_VERSION=4.0.0

# 封装迭代号（我们自己的发布序号）
# 完整版本 = 上游版本-迭代号，例如 4.0.0-1
# 三处必须一致：config.ini / DEBIAN/control / ytdlpwebui.lang；
# 每次提交商店严格递增；Release tag = v<完整版本>（如 v4.0.0-1）
# ⚠️ 迭代号永远不要零填充：dpkg 认为 -01 == -1
PKG_RELEASE=1

# 目标架构（TOS NAS 的 CPU 架构）:
#   amd64 - Intel/AMD x86_64（绝大多数 TerraMaster NAS）
#   arm64 - ARM64/aarch64 机型
# 可被环境变量覆盖（make arm64 即用）
TARGET_ARCH=${TARGET_ARCH:-amd64}

# 二进制构建模式（V6 审核要求可审计来源）:
#   source = 本仓库公开 CI（.github/workflows/build-upstream.yml）从上游源码构建
#            Go 二进制与 quickjs 运行时，产物发布到 Release build-v<上游版本>；
#            提交商店必须用 source 模式
#   compat = 本地迭代用：直接拉上游官方 Release 的预编译二进制与 quickjs-ng
#            官方 release 二进制。产物标注 compat，禁止提交商店
BUILD_MODE=${BUILD_MODE:-compat}

# TOS 应用 id（/usr/local/<appid>/ 目录、config.ini 的 id/system_id、
# lang 文件名、图标文件名必须全部一致；上架后不可变更）
APP_ID=ytdlpwebui

# 运行用户（规范要求专用非 root 用户，preinst 创建；
# config.ini.user 与 systemd User 必须一致）
APP_USER=ytdlpwebui

# 回环监听端口（官方推荐 8000-19999 段；13033 取自上游默认 3033 的易记变体）
APP_PORT=13033

# ---- 随包分发的运行时组件 ----

# yt-dlp（纯 Python zipapp，源码可审计；用 TOS 系统 python3 运行）
# https://github.com/yt-dlp/yt-dlp/releases
YTDLP_VERSION=2026.08.19
SHA256_YTDLP=1fa6733c37ea6fb51c99ad8fe785e7b7e5f3246c9b980230329d4fb72ed8d4d6

# quickjs-ng（yt-dlp 解 YouTube n/sig 签名挑战所需的 JS 运行时；
# https://github.com/quickjs-ng/quickjs ；source 模式从源码 CMake 构建为 qjs，
# compat 模式用官方 release 二进制）
QUICKJS_VERSION=v0.17.0
SHA256_QUICKJS_AMD64=0bfc02511a9f549c28b53880d988fc7cd5d361e90c5e8afdfcd7dc6774ceace5
SHA256_QUICKJS_ARM64=3372133484edf50a69f3c67903af41206d22a061e930e3cfb63269272ef56d2e

# source 模式：本仓库 CI 产物（Release build-v<上游版本>）的 sha256 pin
# CI 首次构建后从 Release 的 SHA256SUMS 回填（./build.sh fetch 会双层校验）
SHA256_TARBALL_AMD64=f239426c252d2340139d32c0d48f44efdc177b171c8d4e0014d40db9ed8203cc
SHA256_TARBALL_ARM64=cdc77d9883c7106af9d348e5af19aef7c2bf542b67c014dfd1af0b12bf1e8a67

# compat 模式：上游官方预编译二进制的 sha256 pin
SHA256_UPSTREAM_AMD64=144b362169534a2d0c221f62acaa09eb999adfa29e33e6e87e5f9f8e99d2cc92
SHA256_UPSTREAM_ARM64=e37460219292af8f23a74649f358aff9fcea058a21731eeeb5c588596ff39edd

# deb 维护者信息（DEBIAN/control 的 Maintainer 与 config.ini 的 publisher）
# 维护者（deb control 的 Maintainer：包出问题找谁 —— 打包者本人）
MAINTAINER_NAME="Moechz"
MAINTAINER_EMAIL="moechz@users.noreply.github.com"

# 应用中心展示的「发布者」（坑 49：本字段归打包者，作者归上游 auth 字段）
PUBLISHER="Moechz"
